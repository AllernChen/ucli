{
  "name": "ucli",
  "version": "0.2.0",
  "description": "UCLI — 多 CLI 编排工作台 GUI（Claude Code / Codex 等的卡片式编排与权限管控）",
  "author": "ucli",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "node --test test/adapter-stats.test.mjs test/db-retention.test.mjs test/cli-tools.test.mjs test/session-discovery.test.mjs test/hook-server.test.mjs test/workbench-keyboard.test.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "schema:codex": "codex app-server generate-json-schema --out .codex-schema",
    "smoke:claude": "claude -p \"Reply with exactly: hello\" --output-format stream-json --verbose",
    "smoke:codex": "codex exec \"say hello\" --json --skip-git-repo-check"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ant-design-vue": "^4.2.3",
    "dayjs": "^1.11.13",
    "node-pty": "^1.1.0",
    "pinia": "^2.2.4",
    "sql.js": "^1.14.1",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.2",
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.8"
  }
}
